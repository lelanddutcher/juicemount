+			if err != nil || n < 0 || strconv.FormatInt(n, 10) != raw || n > math.MaxInt64-deltas[i] {
+				return syscall.EIO
+			}
+		}
+		now := time.Now()
+		a.Parent = 0
+		a.Nlink = 2
+		a.Ctime = now.Unix()
+		a.Ctimensec = uint32(now.Nanosecond())
