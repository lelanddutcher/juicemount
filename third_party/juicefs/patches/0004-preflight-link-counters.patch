+// NewNameParent is one original root-to-parent component, not a path to
+// resolve again against potentially replaced directories.
+type NewNameParent struct {
+	Name  string
+	Inode Ino
+}
+
+// NewNameLink binds a closed private stage to one absent public destination.
+// The caller must journal this expectation before PublishNewName and retain
+// exclusive writer authority. Recovery is only valid after fencing old writers.
+type NewNameLink struct {
+	Parents                 []NewNameParent
+	Name, StageName, Marker string
+	Inode                   Ino
+	Length                  uint64
+}
+
+func (m *redisMeta) PublishNewName(ctx Context, e NewNameLink) syscall.Errno {
+	_, st := m.guardedNewName(ctx, e, false)
+	return st
+}
+
+// RecoverNewName classifies a retained private stage or an exact public link.
+// For the latter it repairs derivative target-directory totals by replacement,
+// never by replaying the relative link increment. New writes must be closed.
+func (m *redisMeta) RecoverNewName(ctx Context, e NewNameLink) (bool, syscall.Errno) {
+	return m.guardedNewName(ctx, e, true)
+}
+
+func (m *redisMeta) guardedNewName(ctx Context, e NewNameLink, recovering bool) (bool, syscall.Errno) {
