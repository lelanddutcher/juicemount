+				if int64(size) > math.MaxInt64-length || allocated > math.MaxInt64-space {
+					return syscall.EOVERFLOW
+				}
+				length += int64(size)
+				space += allocated
+				inodes++
+			}
+			for _, key := range []string{m.dirDataLengthKey(), m.dirUsedSpaceKey(), m.dirUsedInodesKey()} {
