+			return syscall.EEXIST
+		}
+		if pattr.Flags&FlagImmutable != 0 {
+			return syscall.EPERM
+		}
+		if st := m.Access(ctx, parent, MODE_MASK_W|MODE_MASK_X, &pattr); st != 0 {
+			return st
+		}
+		deltas := []int64{int64(a.Length), align4K(a.Length), 1}
+		statKeys := []string{m.dirDataLengthKey(), m.dirUsedSpaceKey(), m.dirUsedInodesKey()}
+		for i, key := range statKeys {
+			raw, err := tx.HGet(ctx, key, parent.String()).Result()
