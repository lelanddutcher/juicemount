+// PutIfAbsent publishes a completely written private inode with a no-replace
+// hard link. Configured storage directories must be trusted and must not be
+// concurrently renamed. A failure after linking retains the uncertain target.
+func (d *filestore) PutIfAbsent(key string, in io.Reader, getters ...AttrGetter) error {
+	if key == "" || key == "." || key == ".." || path.IsAbs(key) || filepath.IsAbs(key) ||
+		path.Clean(key) != key || strings.HasPrefix(key, "../") {
+		return fmt.Errorf("invalid create-only object key")
+	}
+	p := d.path(key)
+	parent := filepath.Dir(p)
+	if err := os.MkdirAll(parent, 0777); err != nil {
+		return err
+	}
+	// Sync the complete chain, including directories left by an interrupted
+	// earlier attempt. Syncing only the leaf would not establish its parents.
+	for dir := parent; ; dir = filepath.Dir(dir) {
+		if err := syncObjectDirectory(dir); err != nil {
+			return err
+		}
+		if filepath.Dir(dir) == dir {
+			break
+		}
+	}
+	f, err := os.CreateTemp(parent, ".juicemount-create-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name()) // Only this attempt's private name, never p.
+	if _, err := io.Copy(f, in); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	if err := os.Link(f.Name(), p); err != nil {
+		return err
+	}
+	return syncObjectDirectory(parent)
+}
+
+func syncObjectDirectory(name string) error {
+	dir, err := os.Open(name)
+	if err != nil {
+		return err
+	}
+	syncErr := dir.Sync()
+	closeErr := dir.Close()
+	if syncErr != nil {
+		return syncErr
+	}
+	return closeErr
 }
 
