<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions MUST be sandboxed or macOS refuses to host them. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Loopback fetch of pre-rendered posters from the JuiceMount daemon
	     (127.0.0.1:11050/thumb-local). Nothing else. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
