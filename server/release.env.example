# JuiceMount server/docker-compose.yml release inputs.
#
# Copy this file outside the repository, replace every placeholder from the
# accepted release manifest, and pass it with `docker compose --env-file`.
# Never put JM_ADMIN_KEY or storage credentials in a committed file.

JM_ADMIN_KEY=REPLACE_WITH_EXISTING_32_PLUS_CHARACTER_VALUE
MINIO_ROOT_PASSWORD=REPLACE_WITH_EXISTING_STRONG_MINIO_PASSWORD

# Multi-architecture manifest digests emitted by the accepted GitHub Actions
# release build. Values must include the `sha256:` prefix; tags such as
# `latest` and `0.5.0` are intentionally not accepted by the compose image
# references.
JM_MANAGER_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
JM_FARM_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
JM_FARM_RENDER_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Physical zpool size from: zpool list -Hp -o size zSSD
JM_FARM_STORAGE_CAPACITY_BYTES=REPLACE_WITH_INTEGER_BYTES

# Redis URL reachable from enrolled NAS/render nodes. Do not use the
# docker-internal `redis` hostname for remote nodes.
JM_FARM_NODE_META_URL=redis://REPLACE_WITH_REACHABLE_HOST:30179/1
