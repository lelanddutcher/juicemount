# JuiceMount server/docker-compose.yml release inputs.
#
# Copy this file outside the repository, replace every placeholder from the
# accepted release manifest, and pass it with `docker compose --env-file`.
# Never put JM_ADMIN_KEY or storage credentials in a committed file.

JM_ADMIN_KEY=REPLACE_WITH_EXISTING_32_PLUS_CHARACTER_VALUE
MINIO_ROOT_PASSWORD=REPLACE_WITH_EXISTING_STRONG_MINIO_PASSWORD

# Multi-architecture manifest digests emitted by the accepted GitHub Actions
# release build. Values must include the `sha256:` prefix; tags such as
# `latest` and `0.5.0` are intentionally not accepted by the compose image
# references.
JM_MANAGER_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
JM_FARM_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
JM_FARM_RENDER_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
JM_RESPPROXY_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS

# --- H-8B RESP proxy (respproxy owns host port 30179; Redis is internal) ---
# Every credential below is a secret. Generate each one separately with
#   openssl rand -hex 32
# Values must be URL-safe (hex is) and at least 32 characters. Rotating one
# requires recreating the services that use it (rollout-compose.sh).
#
# Upstream login of the proxy to Redis (Redis ACL user jm-proxy).
JM_REDIS_PROXY_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Server principals on the proxy. Macs are NOT listed here: they enroll in
# the Manager (Principals page) and an admin approves them.
JM_PROXY_FARM_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
JM_PROXY_MANAGER_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
# `bg` = the server's juicefs mount that runs the volume background jobs.
JM_PROXY_BG_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
# `webdav` = the loopback WebDAV gateway; the proxy gives it no write rights.
JM_PROXY_WEBDAV_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
# `admin` = juicefs format, lease break and the Manager's mode switch.
JM_PROXY_ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# The proxy starts in passthrough with stage births off. To opt in, set BOTH
# JM_RESPPROXY_MODE=enforce and JM_RESPPROXY_STAGE_BIRTH=true. The entrypoint
# refuses true with another initial mode. A later effective mode override
# away from enforce makes stage operations HOLD until enforce is restored.
JM_RESPPROXY_MODE=passthrough
JM_RESPPROXY_STAGE_BIRTH=false

# --- H-8B object keys (MinIO users; server/minio/provision-object-keys.sh) ---
# The volume `setting` key holds no object key. Each juicefs client brings
# its own: jm-client (Get/Put/List, NO delete) for Macs, the farm and WebDAV;
# jm-gc (adds delete) for the server bg mount and Manager gc/compact only.
# The minio-keys service creates both users from these values at every
# `up`. Generate each secret separately with
#   openssl rand -hex 20
# (MinIO secret keys are at most 40 characters). The access-key names are
# optional; jm-client / jm-gc are the defaults.
# JM_OBJ_CLIENT_ACCESS_KEY=jm-client
JM_OBJ_CLIENT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_20
# JM_OBJ_GC_ACCESS_KEY=jm-gc
JM_OBJ_GC_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_20

# --- Per-Mac object keys (NOT YET ENABLED; leave commented) ---
# One MinIO key per approved Mac, removed when the Mac is revoked. Enable
# only by following "Per-Mac object keys" in server/COMPOSE-ROLLOUT.md
# (it starts with rotating MINIO_ROOT_PASSWORD). Two switches, two steps:
#   JM_OBJ_PER_MAC_SERVER=1  M1: minio-keys creates jm-macs + jm-keyadmin,
#                            minio-keyd runs. No Mac is affected.
#   JM_OBJ_PER_MAC=1         M2: the Manager mints and delivers keys. Not
#                            built yet; leave unset.
# Each takes exactly 1 or 0. The key admin secret goes to minio-keys and
# minio-keyd only, never to the Manager.
# JM_OBJ_PER_MAC_SERVER=1
# JM_OBJ_PER_MAC=1
# JM_OBJ_KEYADMIN_ACCESS_KEY=jm-keyadmin
# JM_OBJ_KEYADMIN_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_20

# Physical zpool size from: zpool list -Hp -o size zSSD
JM_FARM_STORAGE_CAPACITY_BYTES=REPLACE_WITH_INTEGER_BYTES

# Redis URL reachable from enrolled NAS/render nodes. Do not use the
# docker-internal `redis` hostname for remote nodes. Since H-8B this is the
# proxy (host port 30179) as the farm principal, user@host ONLY: the Manager
# prints it into the node's docker command and refuses a password here. The
# node gets JM_PROXY_FARM_PASSWORD as JM_META_PASSWORD from the operator's
# shell when the command runs.
JM_FARM_NODE_META_URL=redis://farm@REPLACE_WITH_REACHABLE_HOST:30179/1

# 0.5 remote clients use their own system private route. No public Headscale
# URL or embedded NAS node is required by the default compose. The private
# route must reach the Redis and MinIO client endpoints configured on each Mac.
